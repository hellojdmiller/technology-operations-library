{
  "_readme": "Maps Stack Overflow Developer Survey answer options to landscape vendor ids. Each question is a semicolon-separated multi-select column in the public results CSV. Options mapped to null are recorded as unmapped so the coverage of each question is visible. Category shares are derived from the mapped vendor's own landscape categories, so one option can feed several categories (for example Supabase feeds databases and hosting-and-edge-platforms). Questions that changed between years are listed separately and are not compared across years. Each question lists the landscape categories it speaks to; a mapped vendor contributes only to those categories, so a vendor tagged in several categories does not pull an unrelated category into a question (for example a meeting tool that also carries an AI assistant tag).",
  "survey": "Stack Overflow Annual Developer Survey",
  "publisher": "Stack Exchange Inc.",
  "license": "ODbL 1.0 (database) and DbCL 1.0 (contents)",
  "licenseUrl": "https://opendatacommons.org/licenses/odbl/1-0/",
  "years": {
    "2024": {
      "file": "https://github.com/StackExchange/Survey/raw/refs/heads/main/packages/archive/2024/results.csv",
      "page": "https://survey.stackoverflow.co/2024/",
      "fielded": "May to June 2024"
    },
    "2025": {
      "file": "https://github.com/StackExchange/Survey/raw/refs/heads/main/packages/archive/2025/results.csv",
