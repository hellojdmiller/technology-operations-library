{
  "name": "tol-service-catalog-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only local MCP demonstration backed by a fixed synthetic service catalog.",
  "license": "GPL-3.0-only",
  "engines": { "node": ">=22" },
